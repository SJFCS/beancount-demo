{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["react"],
    "typeRoots": ["../../dashboard/node_modules/@types"],
    "paths": {
      "@plugins/shared/*": ["shared/*"],
      "react": ["../../dashboard/node_modules/@types/react/index.d.ts"],
      "react/*": ["../../dashboard/node_modules/@types/react/*"],
      "react-dom": [
        "../../dashboard/node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": ["../../dashboard/node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "*/frontend.tsx",
    "*/frontend/**/*.ts",
    "*/frontend/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx"
  ]
}
